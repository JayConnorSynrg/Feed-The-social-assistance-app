# FEED Platform - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Supabase Configuration (REQUIRED)
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Mapbox Configuration (REQUIRED for maps)
# ============================================
# Get a free API key from: https://account.mapbox.com/access-tokens/

NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# ============================================
# OpenRouter Configuration (OPTIONAL)
# ============================================
# Required for AI chat features
# Get an API key from: https://openrouter.ai/keys

OPENROUTER_API_KEY=your-openrouter-key-here

# ============================================
# 211 API Configuration (OPTIONAL)
# ============================================
# Required for automated resource syncing from 211 database
# Contact 211.org for API access

API_211_KEY=your-211-api-key-here
API_211_ENDPOINT=https://api.211.org/search/v2

# ============================================
# Federation Configuration (OPTIONAL)
# ============================================
# These are for federated resource sharing between instances
# Will be auto-generated on first run if not provided

# Your instance's unique identifier (e.g., "oakland-feed")
FEDERATION_INSTANCE_ID=your-instance-id

# Your instance's public URL (e.g., "https://oakland.feed.org")
FEDERATION_INSTANCE_URL=https://your-instance-url.com

# RSA private key for federation authentication (PEM format)
# Generate with: node scripts/generate-federation-keypair.js
FEDERATION_PRIVATE_KEY=

# List of trusted federation partners (comma-separated URLs)
FEDERATION_PARTNERS=https://seattle.feed.org,https://chicago.feed.org

# ============================================
# Optional: Custom Branding
# ============================================
# Override default branding for your instance

# Instance display name (default: "FEED")
NEXT_PUBLIC_INSTANCE_NAME=FEED

# Instance logo URL
NEXT_PUBLIC_LOGO_URL=

# Primary brand color (default: #4a5d23)
NEXT_PUBLIC_PRIMARY_COLOR=#4a5d23

# ============================================
# Development Only
# ============================================
# These are only needed for local development

# Local Supabase (when running `npx supabase start`)
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=(see output from supabase start)
