{
  "name": "feed-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "federation:generate-keys": "npx ts-node scripts/federation/generate-keypair.ts",
    "federation:register-local": "npx ts-node scripts/federation/register-local-instance.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "duck-duck-scrape": "^2.2.7",
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "playwright": "^1.60.0"
  }
}
