# ============================================================
# FEED Platform — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# This file IS committed to git (no real secrets here).
# ============================================================

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI token — used for db push and migrations only
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mapbox ---
# Create a token at: https://account.mapbox.com/access-tokens
# Scope it to your production domain for security
NEXT_PUBLIC_MAPBOX_TOKEN=
