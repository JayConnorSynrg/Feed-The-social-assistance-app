  "scripts": {
    "dev": "next dev",
    "dev:test": "NEXT_PUBLIC_TEST_MODE=true next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "seed": "npx ts-node --esm scripts/seed-test-data.ts",
    "test:e2e": "playwright test",
    "test:unit": "find src -name '*.test.mjs' -exec node --test {} +",
    "test:vitest": "vitest run",
    "smoke:prod": "vitest run --config vitest.smoke.config.ts",
    "test": "npm run test:unit && npm run test:vitest"
  },
